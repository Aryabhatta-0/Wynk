experiments/results/musique/*/official_eval/
experiments/results/musique/*/experiment.json
experiments/results/musique/*/*.log
# same for every external benchmark: only the compact summary, report, notes, curves and the
# compressed canonical artifact are committed
experiments/results/mmlu-pro/*/runs/
experiments/results/mmlu-pro/*/experiment.json
experiments/results/mmlu-pro/*/*.log
experiments/results/**/run_cache.jsonl

