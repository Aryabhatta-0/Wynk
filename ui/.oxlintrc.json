{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "error",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 4 }],
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 4 }],
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["src/components/SyncCard.tsx", "src/components/chat/**", "src/components/ui/**", "src/Playground.tsx"],
      "rules": { "react/refs": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "src/ghost/ghost-frames.js", "src/ghost/ghost-animation.js", "playwright-report", "test-results"]
}
